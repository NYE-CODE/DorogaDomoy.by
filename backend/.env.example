# Секретный ключ для JWT (обязательно поменять!)
SECRET_KEY=сгенерируй-длинный-случайный-ключ
AUTH_COOKIE_NAME=dorogadomoy_session
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false

# Разрешённые домены для CORS (через запятую)
ALLOWED_ORIGINS=https://dorogadomoy.by,https://www.dorogadomoy.by,http://localhost:3000
TRUST_PROXY_HEADERS=false
# На проде за nginx: true + TRUSTED_PROXY_IPS (IP nginx, обычно 127.0.0.1,::1)
# TRUSTED_PROXY_IPS=127.0.0.1,::1
# На проде за nginx обязательно true — иначе rate limit считается на один IP для всех
# API_RATE_LIMIT_DEFAULT=600/minute

# Путь к базе данных
# Локально: sqlite:///./petfinder.db
# Продакшен (директория с правами на запись): sqlite:////var/lib/dorogadomoy/petfinder.db
DATABASE_URL=sqlite:///./petfinder.db

# Telegram Bot (получить у @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_USERNAME=dorogadomoy_by_bot
TELEGRAM_WEBHOOK_SECRET=сгенерируй-длинный-секрет-для-webhook

# URL сайта (для ссылок в уведомлениях)
SITE_URL=https://dorogadomoy.by

# Локальный seed (backend/seed.py): пароль админа admin@dorogadomoy.by
# SEED_ADMIN_PASSWORD=задайте-только-для-локальной-разработки

# Groq Vision (AI-подсказки по фото в форме объявления)
# GROQ_API_KEY=

# Шифрование Instagram access_token в БД (опционально; иначе используется SECRET_KEY)
# INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Защита внутренних cron-эндпоинтов
# CRON_SECRET=

# Секция «Как помочь»: белый список доменов для ссылок волонтёра и оплаты (через запятую).
# На проде обязательно: только ваши платёжки и формы (поддомены тоже разрешены).
# HELP_EXTERNAL_URL_HOSTS=bepaid.by,checkout.bepaid.by,t.me,forms.gle

# Дополнительно (безопасность / наблюдаемость)
# Swagger/OpenAPI на проде: API_DOCS_ENABLED=false
# API_DOCS_ENABLED=false
# Полный detail для ошибок валидации 422 (разработка): API_EXPOSE_VALIDATION_DETAILS=true
# Признак БД в ответе GET /health (балансировщики): PUBLIC_HEALTH_INCLUDE_DB=true
